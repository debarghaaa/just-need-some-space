# JUST NEED SOME SPACE. : environment variables (names only; never commit real values)
#
# Where they live:
#   local    -> .env.local (gitignored; `npm run stack:up` writes it for the local stack)
#   preview  -> Vercel project > Environment Variables, scoped to Preview (a separate Supabase project)
#   prod     -> Vercel project > Environment Variables, scoped to Production
# Rotate any value that has ever been pasted somewhere it should not have been.

# ---------------------------------------------------------------- PUBLIC (shipped to the browser)
# Supabase project URL and anon key (Project Settings -> API). Both are designed to be public:
# the anon key only grants what row level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Display only: 'local' when running against scripts/local-supabase. Leave unset in preview / prod.
# NEXT_PUBLIC_BACKEND_MODE=local

# ---------------------------------------------------------------- SERVER ONLY (never in a client bundle)
# Service-role key. Read in exactly one place (src/lib/supabase/server.ts, getServiceSupabase) and
# used by the API routes after the caller's session has been verified. Bypasses RLS: keep it out of
# NEXT_PUBLIC_*, out of logs, out of screenshots.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Deterministic universe seed. Not a secret (it is passed to the renderer so maps match the server),
# but changing it changes every generated world, so treat it as configuration, not a knob.
UNIVERSE_SEED=just-need-some-space
